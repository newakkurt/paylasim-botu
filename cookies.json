import asyncio
from twikit import Client

client = Client('en-US')

async def main():
    await client.login(
        auth_info_1='KULLANICI_ADINIZ',
        auth_info_2='EPOSTA_ADRESINIZ',
        password='SIFRENIZ'
    )
    # Oturum çerezlerini kaydet
    client.save_cookies('cookies.json')
    print("✅ cookies.json başarıyla oluşturuldu!")

asyncio.run(main())